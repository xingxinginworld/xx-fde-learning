# 魔搭 ModelScope API-Inference Access Token
# 获取：https://www.modelscope.cn -> 头像 -> 访问令牌 -> 新建令牌
MODELSCOPE_API_KEY=your_token_here

# 可选：自定义模型（默认已填，按需修改）。模型需在 modelscope.cn 带「API-Inference」闪电标
# EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
# RERANK_MODEL=Qwen/Qwen3-Reranker-4B
# CHAT_MODEL=Qwen/Qwen3-8B

# 可选：微调检索 / 分块参数
# TOP_K=5
# SIM_THRESHOLD=0.4
# COARSE_K=20
# CHUNK_SIZE=500
# CHUNK_OVERLAP=80

# ── 重排（rerank）提供商 ───────────────────────────────────
# ModelScope API-Inference 实测无 /rerank 路由（404），默认改用 Jina（免费额度）。
# RERANK_PROVIDER 可选：jina | modelscope | dashscope | none
RERANK_PROVIDER=jina
# Jina Rerank 免费额度 Key：https://jina.ai/reranker （注册后在控制台获取 API Key）
JINA_API_KEY=your_jina_key_here
# 如需改用阿里云百炼：把 RERANK_PROVIDER 改为 dashscope，并填 DASHSCOPE_API_KEY=sk-xxx
# DASHSCOPE_API_KEY=sk-xxx
